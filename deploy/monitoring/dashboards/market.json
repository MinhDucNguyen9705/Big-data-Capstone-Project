  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "How to read this dashboard",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "mode": "markdown",
        "content": "**UTC · supported range: at most 24 hours · selected dataset: ${dataset}.** crypto is the live pipeline; crypto_demo contains synthetic demonstration data only. Queries read the start/end UTC day partitions, including midnight crossings. Longer ranges are not supported here; use the batch lake for history. The current minute is provisional. Latest price ignores the time picker; check its event timestamp for freshness. Coinbase USD is mapped to the canonical USDT symbol by the project contract; prices are not FX-converted. Empty results remain No data."
      },
      "targets": []
    },
    {
      "id": 2,
      "title": "${symbol} · ${exchange} · 1-minute candles",
      "type": "candlestick",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 16,
        "h": 11
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "mappings": [],
          "unit": "currencyUSD",
          "decimals": 4
        },
        "overrides": []
      },
      "options": {
        "mode": "candles",
        "candleStyle": "candles",
        "colorStrategy": "open-close",
        "fields": {
          "open": "open",
          "high": "high",
          "low": "low",
          "close": "close",
          "volume": "volume"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "hadesarchitect-cassandra-datasource",
            "uid": "cassandra"
          },
          "queryType": "query",
          "rawQuery": true,
          "target": "SELECT exchange, window_start, open, high, low, close, volume FROM ${dataset}.ohlcv_1m WHERE symbol = '${symbol}' AND day IN (toDate((timestamp) $__timeFrom), toDate((timestamp) $__timeTo)) AND window_start >= $__timeFrom AND window_start <= $__timeTo AND exchange = '${exchange}' LIMIT 2880 ALLOW FILTERING"
        }
      ],
      "datasource": {
        "type": "hadesarchitect-cassandra-datasource",
        "uid": "cassandra"
      },
      "transformations": [
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "window_start",
                "desc": false
              }
            ]
          }
        }
      ]
    },
    {
      "id": 3,
      "title": "Latest trade · check event_ts",
      "type": "table",
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 8,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "mappings": []
        },
        "overrides": []
      },
      "options": {
