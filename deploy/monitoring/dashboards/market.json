          "refId": "A",
          "datasource": {
            "type": "hadesarchitect-cassandra-datasource",
            "uid": "cassandra"
          },
          "queryType": "query",
          "rawQuery": true,
          "target": "SELECT exchange, symbol, price, qty, event_ts FROM ${dataset}.latest_price WHERE symbol = '${symbol}' AND exchange = '${exchange}'"
        }
      ],
      "datasource": {
        "type": "hadesarchitect-cassandra-datasource",
        "uid": "cassandra"
