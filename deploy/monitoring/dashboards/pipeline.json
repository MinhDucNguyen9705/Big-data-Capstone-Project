  "panels": [
    {
      "id": 1,
      "title": "How to read this dashboard",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "mode": "markdown",
        "content": "**No data is not zero.** Empty panels mean missing discovery, scrape failures, or a metric not yet emitted. Producer sent counters measure enqueue attempts, not broker acknowledgements; inspect delivery errors too. Kafka Exporter lag only covers groups with committed offsets; Spark Structured Streaming stores its offsets in checkpoints and does not commit them to Kafka. Spark input/processing rates are per query, so downstream handoff rows are not new source trades. Batch duration is trigger execution time, not end-to-end latency."
      },
      "targets": []
    },
    {
      "id": 2,
      "title": "Producer enqueue rate",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "mappings": [],
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (topic) (rate(crypto_ingest_messages_sent_total[$__rate_interval]))",
          "range": true,
          "legendFormat": "{{query}}{{source}}{{topic}}{{consumergroup}} {{pod}}"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
