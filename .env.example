# Copy to .env for local overrides. Every variable has a local default (see src/cryptopipe/config.py),
# so .env is optional. On Kubernetes these come from the pod spec in deploy/.

# Kafka (B, C)
CRYPTO_KAFKA_BOOTSTRAP=localhost:9092
CRYPTO_KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# Data lake (C, D). Cluster: hdfs://hdfs-namenode.storage:8020/lake
CRYPTO_LAKE_ROOT=file:///tmp/crypto-lake
# Defaults to ${CRYPTO_LAKE_ROOT}/_checkpoints when empty
CRYPTO_CHECKPOINT_ROOT=

# Cassandra (C, D, E): comma-separated hosts
CRYPTO_CASSANDRA_HOSTS=localhost
CRYPTO_CASSANDRA_KEYSPACE=crypto

# Shared
CRYPTO_SYMBOLS_FILE=conf/symbols.yaml
CRYPTO_LOG_LEVEL=INFO

# Producers' /metrics port (B)
CRYPTO_METRICS_PORT=8000
